DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_db
RESUME_UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_MB=5
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt
MOCK_EXTRACTION=true
EXTRACTION_PROVIDER=mock
# Set EXTRACTION_PROVIDER=fine-tuned for production GPU fine-tuned extraction
CHROMA_DATA_DIR=data/chroma
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
MATCH_SIMILARITY_THRESHOLD=0.60
MOCK_LLM=true
GROQ_API_KEY=
ANTHROPIC_API_KEY=
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60




