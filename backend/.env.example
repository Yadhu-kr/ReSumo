DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_db
RESUME_UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_MB=5
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt
MOCK_EXTRACTION=false
# Extraction provider: 'groq' (recommended for fast free cloud AI), 'qwen', 'mock', 'remote', or 'fine-tuned'
EXTRACTION_PROVIDER=groq
# GROQ_EXTRACTION_MODEL=llama-3.3-70b-versatile
# EXTRACTION_PROVIDER=qwen
# EXTRACTION_API_BASE_URL=http://127.0.0.1:1234/v1   # LM Studio. For llama-server use http://127.0.0.1:8001/v1
# EXTRACTION_QWEN_MODEL=resume-parser                # must match the model name the server shows
# EXTRACTION_TIMEOUT_SECONDS=300                     # use 600 on slow machines
CHROMA_DATA_DIR=data/chroma
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
MATCH_SIMILARITY_THRESHOLD=0.60
MOCK_LLM=false
GROQ_API_KEY=
ANTHROPIC_API_KEY=
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60




